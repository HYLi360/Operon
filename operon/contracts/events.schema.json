{
  "$comment": "See docs/{en,zh}/reference/plugin-contract.md; unknown event types are skipped after envelope validation.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "metric"
          }
        }
      },
      "then": {
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "minLength": 1,
            "type": "string"
          },
          "metric": {
            "additionalProperties": false,
            "properties": {
              "entity_id": {
                "minLength": 1,
                "type": "string"
              },
              "entity_type": {
                "minLength": 1,
                "type": "string"
              },
              "file": {
                "additionalProperties": false,
                "properties": {
                  "file_id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "sha256": {
                    "pattern": "[a-fA-F0-9]{64}",
                    "type": "string"
                  },
                  "size_bytes": {
                    "maximum": 9223372036854775807,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "file_id",
                  "sha256",
                  "size_bytes"
                ],
                "type": "object"
              },
              "metric_name": {
                "minLength": 1,
                "type": "string"
              },
              "metric_numeric": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "metric_unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "metric_value": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "parameter_set": {
                "minLength": 1,
                "type": "string"
              },
              "qc_stage": {
                "minLength": 1,
                "type": "string"
              },
              "tool": {
                "minLength": 1,
                "type": "string"
              },
              "tool_version": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "entity_type",
              "entity_id",
              "qc_stage",
              "metric_name",
              "metric_value",
              "tool",
              "tool_version",
              "parameter_set"
            ],
            "type": "object"
          },
          "schema_version": {
            "const": 1,
            "maximum": 9223372036854775807,
            "type": "integer"
          },
          "type": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "event_id",
          "type",
          "metric"
        ],
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "artifact"
          }
        }
      },
      "then": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "additionalProperties": false,
            "properties": {
              "compression": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "derived_from": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "entity_id": {
                "minLength": 1,
                "type": "string"
              },
              "entity_type": {
                "minLength": 1,
                "type": "string"
              },
              "format": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "role": {
                "minLength": 1,
                "type": "string"
              },
              "workflow_run_id": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "path",
              "entity_type",
              "entity_id",
              "role",
              "derived_from"
            ],
            "type": "object"
          },
          "event_id": {
            "minLength": 1,
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "maximum": 9223372036854775807,
            "type": "integer"
          },
          "type": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "event_id",
          "type",
          "artifact"
        ],
        "type": "object"
      }
    }
  ],
  "properties": {
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "maximum": 9223372036854775807,
      "type": "integer"
    },
    "type": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "type"
  ],
  "type": "object"
}

#app-layout {
    height: 1fr;
}

#nav {
    width: 18;
    border-right: solid $primary;
}

#main {
    width: 1fr;
}

.body {
    padding: 1 2;
}

#entities-tree {
    width: 40%;
    border-right: solid $primary;
}

#entity-detail-scroll {
    width: 1fr;
}

#files-filters, #runs-filters {
    height: auto;
    /* one blank line above the strip, one column of left margin */
    padding: 1 1 0 1;
}

#runs-more {
    width: 12;
}

#runs-actions {
    padding-left: 1;
}

#files-filter {
    width: 1fr;
}

#files-status {
    width: 24;
}

#runs-status {
    width: 20;
}

#runs-step, #runs-entity {
    width: 1fr;
}

#runs-limit {
    width: 12;
}

#files-table, #runs-table, #decisions-table {
    height: 1fr;
}

#file-detail-scroll {
    height: 40%;
    border-top: solid $primary;
}

#decisions-filters {
    height: auto;
    padding: 0 1;
}

#decisions-profile, #decisions-decision {
    width: 24;
}

#decisions-filter {
    width: 1fr;
}

WriteModal, ErrorDialog {
    align: center middle;
}

#modal-box {
    width: 84;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: solid $primary;
    background: $surface;
}

#modal-title {
    text-style: bold;
    padding-bottom: 1;
}

.modal-label {
    color: $text-muted;
    padding-top: 1;
}

.modal-info {
    padding: 0 0 1 0;
}

#modal-form {
    height: 1fr;
}

#snapshot-view-scroll {
    height: 1fr;
}

#history-table {
    height: 1fr;
}

#modal-command {
    color: $text-muted;
    padding-top: 1;
}

#modal-error {
    color: $error;
    padding-top: 1;
}

#modal-buttons {
    height: auto;
    padding-top: 1;
}

#modal-buttons Button {
    margin-right: 2;
}

#qc-progress {
    padding: 1 0;
}

HelpScreen {
    align: center middle;
}

#help-body {
    width: 64;
    height: auto;
    padding: 1 2;
    border: solid $primary;
    background: $surface;
}

#run-detail-scroll {
    padding: 1 2;
}

#run-detail-layout {
    height: 1fr;
}

#run-follow-log {
    height: 40%;
    padding: 0 1;
    border-top: solid $primary;
}

#environments-table {
    height: 10;
}

#environments-output {
    height: 12;
    padding: 0 1;
    border-top: solid $primary;
}

/* Filter rows: without explicit widths an over-constrained Horizontal gives
   every child its preferred width and pushes the trailing widgets outside the
   row (ODR-0019).  Flexible search inputs take 1fr, narrow controls are fixed. */

#jobs-analysis {
    width: 1fr;
}

#jobs-status {
    width: 20;
}

#jobs-limit {
    width: 12;
}

#modal-box.jobs {
    width: 140;
    height: 80%;
}

#jobs-body {
    height: 1fr;
}

#jobs-table {
    width: 1fr;
    height: 1fr;
}

#jobs-detail-scroll {
    width: 40;
    height: 1fr;
    padding: 0 1;
    border-left: solid $primary;
}

#jobs-detail {
    width: 1fr;
}

#fanout-preview-table {
    height: 6;
}

#table-preview-table {
    height: 10;
}

/* NCBI Datasets import modal: fixed-height preflight log so the button row
   stays visible; the form itself scrolls inside #modal-form. */

#ncbi-preview {
    height: 8;
    border-top: solid $primary;
    padding-top: 1;
}

#ncbi-status {
    height: auto;
    padding-top: 1;
}

#home-actions {
    height: auto;
    padding: 1 2 0 2;
}

#home-actions Button {
    margin-right: 2;
}

#backup-verify-results {
    height: auto;
    padding-top: 1;
}

#classify-summary {
    padding-top: 1;
}

#modal-box.wide {
    width: 140;
}

#hits-filters, #hits-filters-2, #hits-export {
    height: auto;
    padding-top: 1;
}

#hits-analysis, #hits-entity-type, #hits-entity-id,
#hits-query-id, #hits-subject-id, #hits-out {
    width: 1fr;
}

#hits-limit {
    width: 12;
}

#hits-evalue-max {
    width: 16;
}

#hits-format {
    width: 10;
}

#hits-status {
    height: auto;
    padding-top: 1;
}

#config-tabs {
    height: 1fr;
}

#profiles-layout {
    height: 1fr;
}

#profiles-sidebar {
    width: 34;
    border-right: solid $primary;
}

#profiles-list {
    height: 1fr;
}

#profile-editor, #recipe-editor {
    padding: 0 2;
}

#profile-editor {
    width: 1fr;
}

#tools-layout {
    height: 1fr;
    padding: 0 1;
}

#tools-table {
    height: 8;
}

#recipes-table {
    height: 8;
}

#recipe-editor {
    height: 1fr;
    border-top: solid $primary;
}

.config-buttons {
    height: auto;
    padding-top: 1;
}

.config-buttons Button {
    margin-right: 2;
}

.rule-row {
    height: auto;
}

#profile-required-rules, #profile-warnings-rules {
    /* Plain Vertical defaults to height 1fr + overflow hidden, which would
       clip the rules to a fixed window inside the editor scroll area. */
    height: auto;
}

#analyze-parameters {
    /* Same clipping hazard as the profile rule containers. */
    height: auto;
}

#analyze-plan {
    margin-top: 1;
}

.rule-inputs {
    height: auto;
}

.rule-metric {
    width: 24;
}

.rule-operator {
    width: 12;
}

.rule-value {
    width: 14;
}

.rule-code {
    width: 28;
}

.rule-remove {
    min-width: 3;
    width: 3;
    height: 1;
    border: none;
}

.rule-extras, #profile-extras-note, #recipe-extras-note, #recipe-parameters-note {
    padding-left: 2;
}

/* A Select shows a long value in its own width: keep the collapsed control at
   one line and ellipsize instead of growing a row taller. */

SelectCurrent Static#label {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* -- classification profile editor (kind: sequence_classification) -------- */

#classification-editor {
    display: none;
    width: 1fr;
    padding: 0 2;
}

.condition-row, .condition-editor, .source-row, .bestby-row, .classrule-row {
    height: auto;
}

.condition-inputs, .source-inputs, .bestby-inputs, .classrule-inputs,
.condition-body, .condition-group, .source-filter, .source-bestby, .classrule-when {
    height: auto;
}

.condition-field, .condition-value, .source-name, .source-analysis,
.bestby-field, .bestby-rank, .classrule-label {
    width: 1fr;
}

.condition-operator, .condition-mode {
    width: 16;
}

.bestby-direction {
    width: 8;
}

.bestby-default {
    width: 14;
}

.classrule-mode {
    width: 10;
}

.classrule-source {
    width: 26;
}

.condition-remove, .bestby-remove, .source-remove, .classrule-remove {
    min-width: 3;
    width: 3;
    height: 1;
}

.condition-extras, .source-extras, .bestby-extras, .classrule-extras {
    padding-left: 2;
}

#recipe-arguments, #recipe-parameters {
    height: 6;
}

/* -- add-record dialog (Entities screen) ---------------------------------- */

#add-fields {
    /* Same clipping hazard as the profile rule containers. */
    height: auto;
}

.field-row {
    height: auto;
}

.field-key {
    width: 26;
}

.field-value {
    width: 1fr;
}

.field-remove {
    min-width: 3;
    width: 3;
    height: 1;
    border: none;
}

/* -- coverage profile editor (kind: taxonomy_coverage) --------------------- */

#coverage-editor {
    display: none;
    width: 1fr;
    padding: 0 2;
}

#coverage-taxonomy-source {
    width: 24;
}

#coverage-root-taxids, #coverage-exclude-subtrees {
    width: 1fr;
}

#coverage-exclude-patterns {
    height: 6;
}

#coverage-threshold-family, #coverage-threshold-genus {
    width: 16;
}

#snapshot-view-scroll {
    height: 1fr;
    max-height: 24;
}

#history-table {
    height: 12;
}

#history-error {
    color: $error;
}

#wizard-layout {
    height: 1fr;
}

#wizard-box {
    height: 1fr;
    padding: 1 2;
}

#wizard-title {
    text-style: bold;
}

.wizard-heading {
    text-style: bold;
    padding: 1 0;
}

#wizard-pages {
    height: auto;
}

#wizard-bar {
    height: auto;
    padding: 1 2 0 2;
}

#wizard-bar Button {
    margin-right: 2;
}

#wizard-edit-bar {
    height: auto;
    padding-top: 1;
}

.wizard-edit {
    min-width: 14;
    margin-right: 1;
}

#wizard-error {
    color: $error;
    padding: 1 2 0 2;
}

#publish-tabs, #coverage-layout, #remotes-layout {
    height: 1fr;
}

#remotes-table {
    height: auto;
    max-height: 12;
}

#remotes-status, #locations-note {
    height: auto;
}

#locations-form {
    height: auto;
    padding: 0 1;
}

#locations-filter {
    width: 1fr;
}

#locations-table {
    height: 1fr;
}

#remotes-error {
    color: $error;
}

#sync-form {
    height: auto;
}

#sync-remote {
    width: 34;
}

#sync-file-ids {
    width: 1fr;
}

#sync-plan, #sync-status {
    height: auto;
}

#sync-progress {
    height: 1;
    margin-top: 1;
}

#sync-results {
    height: 8;
}

#releases-table {
    height: 8;
}

#release-form {
    height: 1fr;
    padding: 0 1;
}

#release-exclusions-table {
    height: 8;
}

#export-layout {
    padding: 0 1;
}

#export-fields {
    height: auto;
}

.export-column {
    width: 1fr;
    height: auto;
    padding-right: 1;
}

#release-error, #export-error {
    color: $error;
    padding-top: 1;
}

#taxonomy-snapshots-table, #reference-sets-table {
    height: 6;
}

#coverage-form {
    height: auto;
    padding: 0 1;
}

#coverage-reference-set {
    width: 32;
}

#coverage-scope {
    width: 20;
}

#coverage-release {
    width: 20;
}

#coverage-reports-table {
    height: 8;
}

#coverage-report-tabs {
    height: 1fr;
}

#coverage-error {
    color: $error;
}

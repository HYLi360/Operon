include .gitignore
include AGENTS.md
include LICENSE
include MANIFEST.in
include README.md
include README_ZH.md
include docs/en/.readthedocs.yaml
include docs/zh/.readthedocs.yaml
include pyproject.toml
include setup.py
recursive-include .github *.yml
recursive-include benchmarks *.tsv
recursive-include docs *.css *.html *.js *.md *.po *.py *.txt
prune docs/_build
recursive-include operon *.py *.pyx *.tcss
recursive-include operon/tui/assets *.png *.z *.md
recursive-include tests *.py
exclude operon/qc/_parsers.c
exclude operon/qc/_alignment.c
